{
  "name": "aio-calender-mk2-mobile",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-google-auth.cjs",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "build": "cd android && .\\gradlew.bat assembleRelease && cd .. && node -e \"require('fs').copyFileSync('android/app/build/outputs/apk/release/app-release.apk', '../release-builds/AIO-Calender-MK2.apk')\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4"
  }
}
