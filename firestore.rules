rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserWorkspace(data) {
      return data.keys().hasOnly([
        'schedules', 'tasks', 'notifSettings',
        'email', 'displayName', 'photoURL', 'uid', 'id', 'name',
        'createdAt', 'updatedAt', 'lastLogin',
        'activeSemester', 'theme', 'settings', 'preferences', 'metadata', 'status'
      ]) &&
      (!('schedules' in data) || (data.schedules is map && data.schedules.size() <= 30)) &&
      (!('tasks' in data) || (data.tasks is list && data.tasks.size() <= 500)) &&
      (!('notifSettings' in data) || (data.notifSettings is map && data.notifSettings.size() <= 20));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserWorkspace(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserWorkspace(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
