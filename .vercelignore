# ==============================================================================
# Vercel Deployment Ignore Rules - AIO Calender MK2
# Prevents sensitive local artifacts, native Android/desktop code, and archives
# from ever being uploaded or exposed to Vercel builds.
# ==============================================================================

# Native Android and Desktop projects, builds & binaries
android/
mobile/
desktop/
release-apk/
release-builds/
*.apk
*.aab
*.exe
*.msi
target/

# Local backups, bundles & recovery archives
*.bundle
*.zip
*.tar
*.tar.gz
backups/
backup/
aio-calender-mk2-backup*

# Local environment & secrets
.env
.env.*
firebase-applet-config.json
*keystore*
*serviceAccountKey*.json

# Internal scripts & test files
scripts/
.github/
*.test.ts
firestore.rules.test.ts
