{
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "aio-calander-mk2.vercel.app"
        }
      ],
      "destination": "https://aio-calender-mk2.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
